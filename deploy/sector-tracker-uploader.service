# Installed as a systemd *user* unit (systemctl --user, lingering enabled) per
# the README. NEVER add User= here: user-scope managers reject it outright
# (status=216/GROUP, "Failed to determine supplementary groups") and the
# service cannot start at all.
[Unit]
Description=Upload new Hermes vault reports to the market board
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/ds/.local/bin/vault_report_uploader.py
